{
  "expo": {
    "name": "Baiboly sy Fihirana KPR",
    "slug": "mofonaina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconBaiboly.png",
    "scheme": "mofonaina",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "baiboly.fihirana.kpr"
    },
    "android": {
      "package": "baiboly.fihirana.kpr",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/iconBaiboly.png",
        "backgroundImage": "./assets/images/iconBaiboly.png",
        "monochromeImage": "./assets/images/iconBaiboly.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/iconBaiboly.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B7888",
          "image": "./assets/images/couverture/couverture.png",
          "resizeMode": "cover"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9df692da-fe08-4bde-8fbe-23e2e442cd3f"
      }
    }
  }
}
